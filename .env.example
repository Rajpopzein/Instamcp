# ---- Instagram Business Login (Meta App) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match the redirect URI registered in the Meta app dashboard
INSTAGRAM_REDIRECT_URI=https://your-deployment.vercel.app/api/auth/instagram/callback

# ---- MCP client auth ----
# Clients send this as `Authorization: Bearer <value>`, or as `?key=<value>` on the
# MCP URL for clients that cannot set headers (e.g. Claude custom connectors).
MCP_BEARER_SECRET=
# Random 32+ byte string used to HMAC-sign the OAuth `state` parameter
OAUTH_STATE_SECRET=

# ---- Token persistence (Redis) ----
# Set whichever pair your provider gives you; the server detects the style.
# Provisioning Redis from the Vercel Marketplace injects one of these for you.
#   REST (Upstash-compatible):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#   ...or KV_REST_API_URL + KV_REST_API_TOKEN
#   TCP (standard Redis):
#   REDIS_URL=  (or KV_URL=)

# ---- Optional: skip the OAuth flow ----
# A long-lived token from the "Generate token" button on Meta's Instagram API
# setup page. Used only when no token is in Redis, so completing OAuth later
# takes over automatically. With Redis configured it is persisted and then
# auto-refreshed; without Redis you regenerate it roughly every 60 days.
INSTAGRAM_ACCESS_TOKEN=

# ---- Optional ----
# Graph API version; defaults to v25.0
INSTAGRAM_GRAPH_VERSION=v25.0
