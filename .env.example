# ---- Instagram Business Login (Meta App) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match the redirect URI registered in the Meta app dashboard
INSTAGRAM_REDIRECT_URI=https://your-deployment.vercel.app/api/auth/instagram/callback

# ---- MCP client auth ----
# Clients must send: Authorization: Bearer <MCP_BEARER_SECRET>
MCP_BEARER_SECRET=
# Random 32+ byte string used to HMAC-sign the OAuth `state` parameter
OAUTH_STATE_SECRET=

# ---- Token persistence (Upstash Redis, REST API) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Optional ----
# Graph API version; defaults to v25.0
INSTAGRAM_GRAPH_VERSION=v25.0
